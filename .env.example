# Common settings
AGENT_CORE_LLM_TIMEOUT_SECONDS=120
# AGENT_CORE_LLM_MAX_OUTPUT_TOKENS=4096
# AGENT_CORE_MODEL_BACKEND=native
# LangSmith export is disabled by default even if LANGSMITH_TRACING=true.
# AGENT_CORE_LANGCHAIN_TRACING_ENABLED=false

# OpenAI
LLM_PROVIDER=openai
OPENAI_API_KEY=
AGENT_CORE_MODEL=gpt-4.1-mini
AGENT_CORE_MEMORY_MODEL=gpt-4.1-mini

# Optional dedicated provider for memory/internal synthesis.
# If omitted, memory synthesis uses the main provider with AGENT_CORE_MEMORY_MODEL.
# AGENT_CORE_MEMORY_MODEL_BACKEND=native
#
# Example: main assistant on Azure Anthropic, memory synthesis on Azure OpenAI.
# AGENT_CORE_MEMORY_LLM_PROVIDER=azure_openai
# AGENT_CORE_MEMORY_AZURE_OPENAI_ENDPOINT=https://<memory-resource>.openai.azure.com
# AGENT_CORE_MEMORY_AZURE_OPENAI_API_KEY=
# AGENT_CORE_MEMORY_AZURE_OPENAI_API_VERSION=2025-01-01-preview
# AGENT_CORE_MEMORY_MODEL=<memory-deployment-name>

# Example: memory synthesis on a separate OpenAI key.
# AGENT_CORE_MEMORY_LLM_PROVIDER=openai
# AGENT_CORE_MEMORY_OPENAI_API_KEY=
# AGENT_CORE_MEMORY_MODEL=gpt-4.1-mini

# Azure OpenAI
# LLM_PROVIDER=azure_openai
# AGENT_CORE_MODEL_BACKEND=langchain
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AGENT_CORE_MODEL=<deployment-name>
# AGENT_CORE_MEMORY_MODEL=<deployment-name>

# Azure Anthropic / Claude on Azure Foundry
# LLM_PROVIDER=azure_anthropic
# AZURE_ANTHROPIC_ENDPOINT=https://<resource>.services.ai.azure.com/anthropic
# AZURE_ANTHROPIC_API_KEY=
# AZURE_ANTHROPIC_API_VERSION=
# AGENT_CORE_MODEL=claude-opus-4-6
# AGENT_CORE_MEMORY_MODEL=claude-opus-4-6
